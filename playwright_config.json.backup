{
  "server": {
    "port": 61002
  },
  "outputDir": "<project_root>/tmp/browser_wp/",
  "imageResponses": "omit",
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "headless": false,
      "args": [
        "--window-size=2560,1600",
        "--window-position=0,0"
      ]
    }
  }
}